android_app {
    name: "JagarAmberBacklight",
    manifest: "AndroidManifest.xml",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    platform_apis: true,
    certificate: "platform",
    system_ext_specific: true,
    static_libs: ["vendor.daylight.hardware.light.ext-V1-java"],
    optimize: {
        enabled: false,
    },
}
