type wac_fw_update, domain;
type wac_fw_update_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(wac_fw_update)

allow wac_fw_update kmsg_debug_device:chr_file rw_file_perms;
allow wac_fw_update proc_bootprof:file w_file_perms;
allow wac_fw_update proc_mtk_gpio:file rw_file_perms;

allow wac_fw_update vendor_toolbox_exec:file rx_file_perms;

set_prop(wac_fw_update, vendor_wac_prop)
